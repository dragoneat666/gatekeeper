# Cloudflare: account-owned token with Account Rule Lists (Edit) + Account Analytics (Read)
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_LIST_ID=

# Discord: bot token, your server ID, admin user IDs (comma-separated), admin-channel webhook
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_IDS=
DISCORD_WEBHOOK_URL=

# ntfy (phone alerts)
NTFY_URL=http://host.docker.internal:8094
NTFY_TOPIC=gatekeeper
NTFY_TOKEN=

# Dashboard (read-only, basic auth; user defaults to admin)
DASHBOARD_PASSWORD=

# Optional tuning (defaults shown)
# DRY_RUN=false
# POLL_SECONDS=300
# LASTSEEN_SECONDS=3600
# EXPIRE_DAYS=60
# IPV6_PREFIX=64
# PINNED_ENTRIES=2001:db8:1:2::/64
# PROTECTED_HOSTS=jellyfin.example.com,auth.example.com
# ALERT_WINDOW_MINUTES=15
# ALERT_HOST_HITS=20
# ALERT_LOGIN_HITS=3
# ALERT_COOLDOWN_HOURS=6
# SUMMARY_HOUR=8
# TZ=America/New_York
